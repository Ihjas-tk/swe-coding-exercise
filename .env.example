# Copy to .env (./setup.sh does this for you) and fill in the key.
# .env is read from the working directory or any parent; real environment variables win.
# One KEY=value per line; no inline comments after a value.
# .env is git-ignored: never commit it.

# Required for `make ask`, `make eval`, `make smoke` and figure descriptions at ingest.
# Without it `make ingest` still works (no figure descriptions) and `ae check` warns.
ANTHROPIC_API_KEY=

# ---- Optional (defaults shown) -------------------------------------------------------

# Answer and text-to-SQL model.
# AE_ANSWER_MODEL=claude-sonnet-5-5

# Multimodal model that describes each figure once at ingest (cached).
# AE_VLM_MODEL=claude-haiku-4-5-20251001

# Local embedding model (Hugging Face id). BAAI/bge-small-en-v1.5 is ~10x faster to ingest
# and about one question worse at Recall@3. Changing it needs a re-ingest (`make ingest EMBED=...`).
# AE_EMBED_MODEL=ibm-granite/granite-embedding-english-r2

# Extraction backend used by `ae ask` / `ae smoke` when --backend is not given: native | docling | hybrid.
# (The Makefile passes BACKEND=hybrid explicitly; override with `make ask BACKEND=native Q=...`.)
# AE_BACKEND=hybrid

# Directory to ingest instead of the built-in patents/ design_docs/ structured/ (recursive).
# AE_CORPUS=

# Index namespace: "" -> data/index/<backend>.sqlite, "ext" -> data/index/ext/<backend>.sqlite.
# AE_INDEX=

# Console log level (the full DEBUG log always goes to data/logs/ae.log).
# AE_LOG=INFO

# OCR engine inside the Docling backend: tesseract | easyocr (ablation; needs `uv sync --group ablation`).
# AE_DOCLING_OCR=tesseract

# ---- Hugging Face (optional) ---------------------------------------------------------
# Model cache location (default ~/.cache/huggingface/hub); `ae check` and `make models` honour these.
# HF_HOME=
# HF_HUB_CACHE=
# Mirror for networks that block huggingface.co.
# HF_ENDPOINT=
# After `make models`, set this to run without contacting huggingface.co.
# HF_HUB_OFFLINE=1
